# ──────────────────────────────────────────────────────────────
#  .gitignore — Base para un producto web moderno (Node/TypeScript)
#  Se ampliará cuando se inicialice el framework definitivo.
# ──────────────────────────────────────────────────────────────

# Dependencias
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Builds y salidas de compilación
dist/
build/
out/
.next/
.nuxt/
.turbo/
.vercel/
*.tsbuildinfo

# Variables de entorno y secretos (NUNCA versionar)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing y cobertura
coverage/
.nyc_output/
playwright-report/
test-results/

# Cachés de herramientas
.cache/
.eslintcache
.parcel-cache/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Base de datos local / temporales
*.sqlite
*.sqlite3
*.db
tmp/
temp/
