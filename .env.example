# ─────────────────────────────────────────────────────────────
#  Variables de entorno de SkillTree — copia este archivo a `.env`
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (Prisma)
# Ej. local: postgresql://postgres:postgres@localhost:5432/skilltree
# En Neon, usa la cadena de conexión DIRECTA (sin "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/skilltree?schema=public"

# Auth.js (NextAuth v5)
# Genera un secreto con:  npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET="genera-un-secreto-largo-y-aleatorio"

# URL pública de la app (para enlaces en correos, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clave para cargar el contenido de demostración vía /api/seed?key=...
# Usa cualquier texto largo y secreto.
SEED_SECRET="cambia-esto-por-un-secreto-largo"

# ── Correo (opcional en desarrollo) ─────────────────────────
# Si no se configura, en desarrollo los enlaces (p. ej. recuperación de
# contraseña) se imprimen en la consola del servidor.
# MAIL_FROM="SkillTree <no-reply@skilltree.app>"
# RESEND_API_KEY=""
